{
  "manifest_version": 3,
  "name": "MSP2TOOL Clean",
  "version": "1.8.38",
  "description": "MSP2TOOL — clean build with 1.8.38 functional UI/features",
  "permissions": [
    "storage",
    "scripting",
    "debugger"
  ],
  "host_permissions": [
    "https://moviestarplanet2.com/*",
    "https://*.moviestarplanet2.com/*",
    "https://*.mspapis.com/*"
  ],
  "action": {
    "default_title": "MSP2TOOL"
  },
  "background": {
    "service_worker": "bg.js"
  }
}
