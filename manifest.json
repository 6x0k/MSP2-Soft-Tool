{
  "manifest_version": 3,
  "name": "6x0k Space",
  "version": "1.8.53",
  "description": "6x0k Space — privacy-clean MSP2 toolkit",
  "permissions": [
    "storage",
    "scripting",
    "debugger"
  ],
  "host_permissions": [
    "https://moviestarplanet2.com/*",
    "https://*.moviestarplanet2.com/*",
    "https://*.mspapis.com/*"
  ],
  "action": {
